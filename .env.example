# Bloo AI - copy to `.env` and fill the two keys.
# Never commit `.env`.
#
# Format: KEY=value, one per line, NO spaces around '='. Docker Compose reads this
# file via env_file and is stricter than dotenvy: `KEY = value` leaks the spaces
# into the value and can break bind addresses.
# Keep this file pure ASCII: setup.ps1 writes .env as ASCII.

# --- server -------------------------------------------------
BLOO_BIND=127.0.0.1:27810
BLOO_DATA_DIR=./data
BLOO_CONTENT_DIR=./content
BLOO_AUTO_MIGRATE=1

# --- database (port 27432 - NOT 5432) -----------------------
DATABASE_URL=postgres://bloo:bloo_local@127.0.0.1:27432/blooai

# --- HAL-X THX-01 (routing, reranking, extraction, citations)
# Cloud gateway:
HALX_BASE_URL=https://api.hal-x.ai
HALX_API_KEY=
# Self-hosted sidecar instead (tools/thx01-local) - comment the two lines above:
#   HALX_BASE_URL=http://127.0.0.1:27812
#   HALX_API_KEY=bloo-local

# --- chat model (prose only, OpenAI-compatible) -------------
# LLM_BASE_URL is the BASE, without /chat/completions (Bloo appends it).
# OpenCode has TWO incompatible base paths:
#   Go subscription       : https://opencode.ai/inference/go/openai/v1
#   Console pay-as-you-go : https://opencode.ai/inference/openai/v1
# A Go key on the Console path authenticates and then returns 402.
# OpenAI:    https://api.openai.com/v1   model gpt-4o-mini
# Groq:      https://api.groq.com/openai/v1
# Ollama:    http://127.0.0.1:11434/v1
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
# Measured median time to first token with a real 4-chunk prompt:
#   deepseek-v4.1-flash 3.2 s   <- chosen default
#   glm-5.3-flash       2.6 s   (faster, cheaper; swap if latency matters)
#   minimax-m3.1-flash  1.9 s, but a 22 s outlier
#   mimo-v2.6-flash     1.6 s direct, 4.7 s / 15 s through the gateway
LLM_MODEL=deepseek-v4.1-flash

# --- local embeddings (ONNX, no API) ------------------------
# local | openai | mock.  `local` is the contract: 384 d, ~35 MB on disk, ~130 MB RSS.
BLOO_EMBED_PROVIDER=local
BLOO_EMBED_MODEL=BAAI/bge-small-en-v1.5
BLOO_EMBED_DIM=384
# Dormant remote backend (Jina / Mistral / OpenAI). Only used when the provider is `openai`.
# Changing the provider also changes the dimension -> migration vector(N) + full re-index.
# BLOO_EMBED_BASE_URL=https://api.jina.ai/v1
# BLOO_EMBED_API_KEY=

# --- decision backend: auto | thx | local | off -------------
# auto = THX-01 when HALX_API_KEY is set, otherwise the local fallback
BLOO_DECIDER=auto
# Use THX-01 to cut citation spans at query time. Costs ~2-3 s per answer on CPU;
# when 0, citations use a query-relevant sentence (still verbatim).
BLOO_THX_CITATIONS=0

RUST_LOG=info,bloo_api=debug,bloo_core=debug
